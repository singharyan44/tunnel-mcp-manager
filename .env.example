# Copy this to .env and fill in your own values. NEVER commit .env.
# The app only stores the VARIABLE NAMES in settings.json, never the secrets.

# Where is tunnel-client-runtime? Absolute path or name on PATH.
TUNNEL_CLIENT_RUNTIME=tunnel-client-runtime.exe

# OpenAI tunnel credentials (create tunnels in OpenAI dashboard first).
# Each server needs its OWN tunnel ID. The tray Settings UI manages them.
CONTROL_PLANE_API_KEY=put-your-key-here
CONTROL_PLANE_TUNNEL_ID=tunnel_paste-obsidian-id-here

# External main MCP (Obsidian local REST). Example default port.
MCP_SERVER_URL=http://127.0.0.1:27123/mcp/

# Optional: override auto-built stdio commands (power users only).
# OPENSCAD_MCP_COMMAND=
# GODOT_MCP_COMMAND=
# FILESYSTEM_MCP_COMMAND=

# Optional: extra headers forwarded to MCP servers.
# MCP_EXTRA_HEADERS=
